PGHOST=/var/run/postgresql
PGDATABASE=personal_context
PGUSER=postgres
# PGPASSWORD=
AUTO_MANAGE_DB=false
TRUST_OPENAI_TUNNEL_IDENTITY=false
REQUIRE_ACTOR_IDENTIFICATION=false

EMBEDDINGS_ENABLED=false
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_AUTO_PULL=true
ATTACHMENT_STORAGE_DIR=./data/attachments
OLLAMA_HOST=http://127.0.0.1:11434

# Loopback-only Inspection tool
INSPECTION_HOST=127.0.0.1
INSPECTION_PORT=4180

# Optional native-phone TLS gateway. Bind one exact private-LAN IPv4 address.
# The key and token files must be regular mode-0600 files outside this repository.
INSPECTION_MOBILE_HOST=192.168.1.100
INSPECTION_MOBILE_PORT=4181
INSPECTION_MOBILE_TLS_KEY=/home/you/.config/personal-context/inspection-tls.key
INSPECTION_MOBILE_TLS_CERT=/home/you/.config/personal-context/inspection-tls.crt
INSPECTION_MOBILE_TOKEN_PATH=/home/you/.config/personal-context/inspection-mobile-token
