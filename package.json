{
  "name": "personal-context-server",
  "version": "1.0.0",
  "description": "A personalized context-driven MCP archive server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "actor-key:generate": "node scripts/generate-actor-keypair.mjs",
    "actor-key:enroll": "npm run build && node scripts/enroll-actor-key.mjs",
    "actor-key:revoke": "npm run build && node scripts/revoke-actor-key.mjs",
    "actor-session:approve": "npm run build && node scripts/manage-actor-session.mjs approve",
    "actor-session:deny": "npm run build && node scripts/manage-actor-session.mjs deny",
    "actor-session:revoke": "npm run build && node scripts/manage-actor-session.mjs revoke",
    "wake-policy:dry-run": "npm run build && node dist/wake/cli.js",
    "wake-policy:run": "npm run build && node dist/wake/cli.js",
    "wake-delivery:retry": "npm run build && node dist/wake/cli.js",
    "attachments:audit": "npm run build && node scripts/audit-attachments.mjs",
    "inspection:start": "npm run build && node dist/inspection/server.js",
    "inspection:mobile": "npm run build && node dist/inspection/mobile-server.js",
    "mcp:config": "node scripts/generate-mcp-config.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yurei-dll/personal-context-server.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yurei-dll/personal-context-server/issues"
  },
  "homepage": "https://github.com/yurei-dll/personal-context-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
